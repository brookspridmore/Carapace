# Carapace environment

# Carapace binds to localhost only. Tailscale Serve handles external exposure.
PORT=3080
HOST=127.0.0.1

# OpenClaw integration mode: mock | readonly | live
# - mock     → demo data only (UI development)
# - readonly → read real OpenClaw state from disk; never falls back to mock
# - live     → reserved for controlled writes (not implemented yet)
OPENCLAW_MODE=readonly

# OpenClaw filesystem root. PRIMARY integration path.
# Carapace reads agents, memory, sessions, logs and config from here.
# Default OpenClaw native install: ~/.openclaw
OPENCLAW_ROOT_PATH=~/.openclaw

# Legacy HTTP gateway (optional). Only used if OPENCLAW_ROOT_PATH is unset.
# Most native OpenClaw installs do NOT need this.
# OPENCLAW_BASE_URL=http://127.0.0.1:18789

# Alias accepted for backwards compatibility. Prefer OPENCLAW_BASE_URL.
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Local SQLite database (Postgres FTS used in Lovable preview only).
DATABASE_URL=sqlite:///var/lib/carapace/carapace.db

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Provider keys (forwarded to OpenClaw via approved proxy calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
