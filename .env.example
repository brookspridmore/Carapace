# Carapace environment

# Carapace binds to localhost only. Tailscale Serve handles external exposure.
PORT=3080
HOST=127.0.0.1

# OpenClaw HTTP API. Carapace proxies every request through its own backend —
# the browser never connects to OpenClaw directly.
# Default: http://127.0.0.1:18789 (OpenClaw native install).
OPENCLAW_BASE_URL=http://127.0.0.1:18789

# Alias accepted for backwards compatibility. Prefer OPENCLAW_BASE_URL.
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Local SQLite database (Postgres FTS used in Lovable preview only).
DATABASE_URL=sqlite:///var/lib/carapace/carapace.db

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Provider keys (forwarded to OpenClaw via approved proxy calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
