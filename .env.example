# Carapace environment

# Carapace binds to localhost only. Tailscale Serve handles external exposure.
PORT=3080
HOST=127.0.0.1

# OpenClaw integration mode: mock | readonly | gateway | live
# - mock     → demo data only (UI development, no OpenClaw required)
# - readonly → read real OpenClaw state from disk via filesystem adapter
# - gateway  → full god-mode via OpenClaw WebSocket gateway (recommended for VPS)
# - live     → alias for gateway (backward compat)
OPENCLAW_MODE=gateway

# OpenClaw WebSocket gateway URL.
# Used when OPENCLAW_MODE=gateway or OPENCLAW_MODE=live.
# Default OpenClaw install binds to ws://127.0.0.1:18789
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Gateway auth token (set in your OpenClaw config under [gateway].api_token).
# Required for gateway mode — requests without a valid token are rejected.
OPENCLAW_TOKEN=your-openclaw-api-token-here

# OpenClaw filesystem root.
# Used when OPENCLAW_MODE=readonly to read agents, memory, sessions, logs, config.
# Default OpenClaw native install: ~/.openclaw
OPENCLAW_ROOT_PATH=~/.openclaw

# Local SQLite database (Postgres FTS used in Lovable preview only).
DATABASE_URL=sqlite:///var/lib/carapace/carapace.db

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Provider keys (forwarded to OpenClaw via approved proxy calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
